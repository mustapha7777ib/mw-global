# Copy to `.env.local` for local development, and set the same values in the
# Netlify dashboard (Site settings → Environment variables) for the live site.
# Never commit real keys — `.env` and `.env*.local` are gitignored.

# ── Quote form delivery ──────────────────────────────────────────────────────
# REQUIRED. Without it the contact form refuses submissions and tells visitors
# to phone instead, rather than silently losing the enquiry.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Both default to the values in lib/site.ts.
# QUOTE_TO_EMAIL=mwglobal.team@com
# The sending domain must be verified in Resend before this is accepted.
# QUOTE_FROM_EMAIL=enquiries@mwglobal.org.ng

# ── Site URL ─────────────────────────────────────────────────────────────────
# Optional. Overrides site.url for canonicals, og:image and the sitemap —
# useful to point a staging deploy at its own domain.
# NEXT_PUBLIC_SITE_URL=https://mwglobal.org.ng
